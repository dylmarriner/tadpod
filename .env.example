NODE_ENV=development
APP_NAME=TADPODS
POSTGRES_PASSWORD=replace-this-database-password
DATABASE_URL=postgresql://tadpods:replace-this-database-password@localhost:5432/tadpods?schema=public
AUTH_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
DEFAULT_CURRENCY=NZD
NEGATIVE_STOCK_ENABLED=false
MINIO_ROOT_USER=tadpods
MINIO_ROOT_PASSWORD=replace-this-minio-password
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=tadpods
S3_SECRET_KEY=replace-this-minio-password
S3_BUCKET=tadpods-attachments
SMTP_HOST=localhost
SMTP_PORT=1025
SEED_ADMIN_EMAIL=admin@tadpods.local
SEED_ADMIN_PASSWORD=ChangeMe-123!
