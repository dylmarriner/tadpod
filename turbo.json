{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "APP_NAME",
    "POSTGRES_PASSWORD",
    "DATABASE_URL",
    "AUTH_SECRET",
    "CORS_ORIGIN",
    "API_URL",
    "NEXT_PUBLIC_API_URL",
    "API_PORT",
    "WEB_PORT",
    "DEFAULT_CURRENCY",
    "NEGATIVE_STOCK_ENABLED",
    "MINIO_ROOT_USER",
    "MINIO_ROOT_PASSWORD",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_BUCKET",
    "SMTP_HOST",
    "SMTP_PORT",
    "SEED_ADMIN_EMAIL",
    "SEED_ADMIN_PASSWORD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
