generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum WarehouseStatus {
  ACTIVE
  ARCHIVED
}

enum StockMovementType {
  OPENING_STOCK
  GOODS_RECEIPT
  SALES_DELIVERY
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  WAREHOUSE_TRANSFER_OUT
  WAREHOUSE_TRANSFER_IN
  POSITIVE_ADJUSTMENT
  NEGATIVE_ADJUSTMENT
  STOCK_COUNT_CORRECTION
  REVERSAL
}

model User {
  id           String           @id @default(uuid()) @db.Uuid
  email        String           @unique @db.VarChar(254)
  displayName  String           @db.VarChar(120)
  passwordHash String           @db.Text
  status       UserStatus       @default(ACTIVE)
  version      Int              @default(1)
  lastLoginAt  DateTime?        @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)
  roles        UserRole[]
  sessions     RefreshSession[]
  auditLogs    AuditLog[]
  attachments  Attachment[]     @relation("AttachmentUploader")
  stockMovements StockMovement[] @relation("StockMovementActor")
  stockCountsCreated StockCount[] @relation("StockCountCreatedBy")

  @@index([status, email])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(80)
  name        String           @unique @db.VarChar(120)
  description String?          @db.VarChar(300)
  system      Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(120)
  name        String           @db.VarChar(160)
  description String?          @db.VarChar(300)
  roles       RolePermission[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshSession {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  tokenHash  String        @unique @db.Char(64)
  status     SessionStatus @default(ACTIVE)
  userAgent  String?       @db.VarChar(500)
  ipAddress  String?       @db.Inet
  expiresAt  DateTime      @db.Timestamptz(6)
  revokedAt  DateTime?     @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @db.Timestamptz(6)
  lastUsedAt DateTime?     @db.Timestamptz(6)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @db.VarChar(120)
  entityId   String?  @db.VarChar(120)
  requestId  String?  @db.VarChar(120)
  ipAddress  String?  @db.Inet
  metadata   Json
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  scope          String   @db.VarChar(120)
  key            String   @db.VarChar(200)
  requestHash    String   @db.Char(64)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime @db.Timestamptz(6)

  @@unique([scope, key])
  @@index([expiresAt])
}

model DocumentSequence {
  key       String   @id @db.VarChar(80)
  prefix    String   @db.VarChar(20)
  nextValue BigInt   @default(1)
  padding   Int      @default(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model BrandSettings {
  singletonKey   String   @id @default("default") @db.VarChar(20)
  displayName    String   @default("TADPODS") @db.VarChar(80)
  legalName      String?  @db.VarChar(160)
  logoUrl        String?  @db.Text
  primaryColour  String   @default("#0F766E") @db.Char(7)
  accentColour   String   @default("#14B8A6") @db.Char(7)
  documentFooter String   @default("Generated by TADPODS") @db.VarChar(500)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  updatedById    String?  @db.Uuid
}

model SystemSettings {
  singletonKey         String   @id @default("default") @db.VarChar(20)
  defaultCurrency      String   @default("NZD") @db.Char(3)
  negativeStockEnabled Boolean  @default(false)
  timeZone             String   @default("Pacific/Auckland") @db.VarChar(80)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)
}

model TaxRate {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(40)
  name      String    @db.VarChar(120)
  rateBasis Int
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  products  Product[]
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  objectKey    String   @unique @db.Text
  fileName     String   @db.VarChar(255)
  contentType  String   @db.VarChar(160)
  sizeBytes    BigInt
  sha256       String   @db.Char(64)
  entityType   String   @db.VarChar(120)
  entityId     String   @db.VarChar(120)
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  uploadedBy   User     @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  topic         String       @db.VarChar(120)
  aggregateType String       @db.VarChar(120)
  aggregateId   String       @db.VarChar(120)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @db.Timestamptz(6)
  lockedAt      DateTime?    @db.Timestamptz(6)
  lockedBy      String?      @db.VarChar(120)
  completedAt   DateTime?    @db.Timestamptz(6)
  lastError     String?      @db.Text
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
}

// --- Phase 2: products, categories, supplier codes, warehouses ---
//
// A full `suppliers` module (addresses, purchase orders, bills, payments) belongs to Phase 3.
// Task 1 only needs somewhere real to point `Product.preferredSupplier` and `ProductSupplier`
// at, so a deliberately minimal `Supplier` table (id/code/name/active) is introduced here rather
// than inventing fake supplier records or storing supplier code/name as free text on
// `ProductSupplier`. Phase 3 can widen this table (addresses, contact details, terms, balances)
// with additive migrations without breaking the foreign keys created in this phase.

model ProductCategory {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @unique @db.VarChar(160)
  parentId  String?           @db.Uuid
  createdAt DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @db.Timestamptz(6)
  parent    ProductCategory?  @relation("ProductCategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children  ProductCategory[] @relation("ProductCategoryParent")
  products  Product[]

  @@index([parentId])
}

model Supplier {
  id           String            @id @default(uuid()) @db.Uuid
  code         String            @unique @db.VarChar(40)
  name         String            @db.VarChar(160)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(6)
  productLinks ProductSupplier[]
  preferredFor Product[]         @relation("ProductPreferredSupplier")

  @@index([active])
}

model Product {
  id                     String            @id @default(uuid()) @db.Uuid
  sku                    String            @unique @db.VarChar(64)
  barcode                String?           @unique @db.VarChar(64)
  name                   String            @db.VarChar(200)
  description            String?           @db.Text
  categoryId             String?           @db.Uuid
  unitOfMeasure          String            @db.VarChar(20)
  salesPriceMinorUnits   BigInt            @default(0)
  purchaseCostMinorUnits BigInt            @default(0)
  taxRateId              String?           @db.Uuid
  reorderLevel           Decimal           @default(0) @db.Decimal(18, 4)
  reorderQuantity        Decimal           @default(0) @db.Decimal(18, 4)
  leadTimeDays           Int               @default(0)
  preferredSupplierId    String?           @db.Uuid
  status                 ProductStatus     @default(ACTIVE)
  createdAt              DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @db.Timestamptz(6)
  category               ProductCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  taxRate                TaxRate?          @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  preferredSupplier      Supplier?         @relation("ProductPreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  suppliers              ProductSupplier[]
  stockMovements         StockMovement[]
  stockCountLines        StockCountLine[]

  @@index([categoryId])
  @@index([status])
  @@index([preferredSupplierId])
}

model ProductSupplier {
  id                     String   @id @default(uuid()) @db.Uuid
  productId              String   @db.Uuid
  supplierId             String   @db.Uuid
  supplierProductCode    String   @db.VarChar(80)
  purchaseCostMinorUnits BigInt   @default(0)
  preferred              Boolean  @default(false)
  leadTimeDays           Int      @default(0)
  createdAt              DateTime @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @db.Timestamptz(6)
  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier               Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@index([supplierProductCode])
}

model Warehouse {
  id           String          @id @default(uuid()) @db.Uuid
  code         String          @unique @db.VarChar(20)
  name         String          @unique @db.VarChar(160)
  addressLine1 String?         @db.VarChar(200)
  addressLine2 String?         @db.VarChar(200)
  city         String?         @db.VarChar(120)
  region       String?         @db.VarChar(120)
  postalCode   String?         @db.VarChar(20)
  country      String?         @db.VarChar(120)
  status       WarehouseStatus @default(ACTIVE)
  isDefault    Boolean         @default(false)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(6)
  stockMovements StockMovement[]
  stockCounts    StockCount[]

  @@index([status])
}

// --- Phase 2 Task 2: immutable stock-movement ledger ---
//
// `StockMovement` is the sole source of truth for stock on hand — no `Product` or
// `Warehouse` row stores an editable balance. Rows are append-only: corrections are made
// with an equal-and-opposite `REVERSAL` row linked via `reversalOfId`, never by editing or
// deleting a posted row. Immutability is enforced twice: the service layer exposes no
// update/delete methods, and a Postgres trigger (added in this task's migration) rejects
// any `UPDATE`/`DELETE` against this table outright, so a bug or a direct SQL session can't
// silently corrupt posted history either.
//
// `(sourceType, sourceId, sourceLineId)` is unique so a given external event (e.g. one
// goods-receipt line) can only ever create a stock effect once, even under retries.
// `idempotencyKey` is a second, independent uniqueness guard for client-side retry safety
// on the posting request itself (a client can resend the same `POST` and get the original
// result back rather than a duplicate or an error).
model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  productId      String            @db.Uuid
  warehouseId    String            @db.Uuid
  movementType   StockMovementType
  signedQuantity Decimal           @db.Decimal(18, 4)
  postedAt       DateTime          @default(now()) @db.Timestamptz(6)
  sourceType     String            @db.VarChar(60)
  sourceId       String            @db.VarChar(120)
  sourceLineId   String            @db.VarChar(120)
  idempotencyKey String?           @unique @db.VarChar(200)
  reversalOfId   String?           @db.Uuid
  actorId        String?           @db.Uuid
  notes          String?           @db.VarChar(2000)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)

  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  actor       User?           @relation("StockMovementActor", fields: [actorId], references: [id], onDelete: SetNull)
  reversalOf  StockMovement?  @relation("StockMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy  StockMovement[] @relation("StockMovementReversal")

  @@unique([sourceType, sourceId, sourceLineId])
  @@index([productId, warehouseId])
  @@index([warehouseId])
  @@index([reversalOfId])
  @@index([postedAt])
}

enum StockCountStatus {
  DRAFT
  POSTED
}

// A stock count is a draft worksheet: it freezes `expectedQuantity` per line at creation
// time from the ledger, staff fill in `countedQuantity` as they count, and posting turns
// each line's variance into a `STOCK_COUNT_CORRECTION` movement through the same
// `StockPostingService.postMovements` batch primitive transfers use — so a count either
// posts every non-zero-variance line, or none of them. Once `status` is `POSTED` the count
// is locked: `StockCountsService` exposes no way to edit a line or repost.
model StockCount {
  id          String           @id @default(uuid()) @db.Uuid
  warehouseId String           @db.Uuid
  status      StockCountStatus @default(DRAFT)
  notes       String?          @db.VarChar(2000)
  createdById String           @db.Uuid
  postedAt    DateTime?        @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy User             @relation("StockCountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines     StockCountLine[]

  @@index([warehouseId, status])
}

model StockCountLine {
  id               String   @id @default(uuid()) @db.Uuid
  stockCountId     String   @db.Uuid
  productId        String   @db.Uuid
  expectedQuantity Decimal  @db.Decimal(18, 4)
  countedQuantity  Decimal? @db.Decimal(18, 4)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, productId])
  @@index([productId])
}
