generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum WarehouseStatus {
  ACTIVE
  ARCHIVED
}

enum StockMovementType {
  OPENING_STOCK
  GOODS_RECEIPT
  SALES_DELIVERY
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  WAREHOUSE_TRANSFER_OUT
  WAREHOUSE_TRANSFER_IN
  POSITIVE_ADJUSTMENT
  NEGATIVE_ADJUSTMENT
  STOCK_COUNT_CORRECTION
  REVERSAL
}

model User {
  id                                String                      @id @default(uuid()) @db.Uuid
  email                             String                      @unique @db.VarChar(254)
  displayName                       String                      @db.VarChar(120)
  passwordHash                      String                      @db.Text
  status                            UserStatus                  @default(ACTIVE)
  version                           Int                         @default(1)
  lastLoginAt                       DateTime?                   @db.Timestamptz(6)
  createdAt                         DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                         DateTime                    @updatedAt @db.Timestamptz(6)
  roles                             UserRole[]
  sessions                          RefreshSession[]
  auditLogs                         AuditLog[]
  attachments                       Attachment[]                @relation("AttachmentUploader")
  stockMovements                    StockMovement[]             @relation("StockMovementActor")
  stockCountsCreated                StockCount[]                @relation("StockCountCreatedBy")
  purchaseOrdersCreated             PurchaseOrder[]             @relation("PurchaseOrderCreatedBy")
  purchaseOrdersApproved            PurchaseOrder[]             @relation("PurchaseOrderApprovedBy")
  goodsReceiptsReceived             GoodsReceipt[]              @relation("GoodsReceiptReceivedBy")
  salesOrdersCreated                SalesOrder[]                @relation("SalesOrderCreatedBy")
  salesOrdersConfirmed              SalesOrder[]                @relation("SalesOrderConfirmedBy")
  stockReservationsCreated          StockReservation[]          @relation("StockReservationCreatedBy")
  deliveriesCreated                 Delivery[]                  @relation("DeliveryCreatedBy")
  deliveriesPosted                  Delivery[]                  @relation("DeliveryPostedBy")
  backordersCreated                 Backorder[]                 @relation("BackorderCreatedBy")
  backorderAllocationsCreated       BackorderAllocation[]       @relation("BackorderAllocationCreatedBy")
  customerInvoicesCreated           CustomerInvoice[]           @relation("CustomerInvoiceCreatedBy")
  customerInvoicesVoided            CustomerInvoice[]           @relation("CustomerInvoiceVoidedBy")
  customerPaymentsCreated           CustomerPayment[]           @relation("CustomerPaymentCreatedBy")
  customerPaymentAllocationsCreated CustomerPaymentAllocation[] @relation("CustomerPaymentAllocationCreatedBy")
  customerCreditsCreated            CustomerCredit[]            @relation("CustomerCreditCreatedBy")
  customerCreditApplicationsCreated CustomerCreditApplication[] @relation("CustomerCreditApplicationCreatedBy")
  customerRefundsCreated            CustomerRefund[]            @relation("CustomerRefundCreatedBy")
  installmentPlansCreated           InstallmentPlan[]           @relation("InstallmentPlanCreatedBy")
  supplierBillsCreated              SupplierBill[]              @relation("SupplierBillCreatedBy")
  supplierBillsVoided               SupplierBill[]              @relation("SupplierBillVoidedBy")
  supplierPaymentsCreated           SupplierPayment[]           @relation("SupplierPaymentCreatedBy")
  supplierPaymentAllocationsCreated SupplierPaymentAllocation[] @relation("SupplierPaymentAllocationCreatedBy")
  supplierCreditsCreated            SupplierCredit[]            @relation("SupplierCreditCreatedBy")
  supplierCreditApplicationsCreated SupplierCreditApplication[] @relation("SupplierCreditApplicationCreatedBy")
  supplierRefundsCreated            SupplierRefund[]            @relation("SupplierRefundCreatedBy")

  @@index([status, email])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(80)
  name        String           @unique @db.VarChar(120)
  description String?          @db.VarChar(300)
  system      Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(120)
  name        String           @db.VarChar(160)
  description String?          @db.VarChar(300)
  roles       RolePermission[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshSession {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  tokenHash  String        @unique @db.Char(64)
  status     SessionStatus @default(ACTIVE)
  userAgent  String?       @db.VarChar(500)
  ipAddress  String?       @db.Inet
  expiresAt  DateTime      @db.Timestamptz(6)
  revokedAt  DateTime?     @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @db.Timestamptz(6)
  lastUsedAt DateTime?     @db.Timestamptz(6)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @db.VarChar(120)
  entityId   String?  @db.VarChar(120)
  requestId  String?  @db.VarChar(120)
  ipAddress  String?  @db.Inet
  metadata   Json
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  scope          String   @db.VarChar(120)
  key            String   @db.VarChar(200)
  requestHash    String   @db.Char(64)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime @db.Timestamptz(6)

  @@unique([scope, key])
  @@index([expiresAt])
}

model DocumentSequence {
  key       String   @id @db.VarChar(80)
  prefix    String   @db.VarChar(20)
  nextValue BigInt   @default(1)
  padding   Int      @default(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model BrandSettings {
  singletonKey   String   @id @default("default") @db.VarChar(20)
  displayName    String   @default("TADPODS") @db.VarChar(80)
  legalName      String?  @db.VarChar(160)
  logoUrl        String?  @db.Text
  primaryColour  String   @default("#0F766E") @db.Char(7)
  accentColour   String   @default("#14B8A6") @db.Char(7)
  documentFooter String   @default("Generated by TADPODS") @db.VarChar(500)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  updatedById    String?  @db.Uuid
}

model SystemSettings {
  singletonKey                             String   @id @default("default") @db.VarChar(20)
  defaultCurrency                          String   @default("NZD") @db.Char(3)
  negativeStockEnabled                     Boolean  @default(false)
  timeZone                                 String   @default("Pacific/Auckland") @db.VarChar(80)
  // Null means no value threshold is enforced: any actor with `purchasing.write` may confirm
  // a purchase order directly. When set, an order whose total meets or exceeds this value
  // must go through submit-for-approval/approve (`purchasing.approve`) instead of a direct
  // confirm — see `PurchaseOrdersService.confirm`.
  purchaseOrderApprovalThresholdMinorUnits BigInt?  @db.BigInt
  updatedAt                                DateTime @updatedAt @db.Timestamptz(6)
}

model TaxRate {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(40)
  name      String    @db.VarChar(120)
  rateBasis Int
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  products  Product[]
  customerInvoiceLines CustomerInvoiceLine[]
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  objectKey    String   @unique @db.Text
  fileName     String   @db.VarChar(255)
  contentType  String   @db.VarChar(160)
  sizeBytes    BigInt
  sha256       String   @db.Char(64)
  entityType   String   @db.VarChar(120)
  entityId     String   @db.VarChar(120)
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  uploadedBy   User     @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  topic         String       @db.VarChar(120)
  aggregateType String       @db.VarChar(120)
  aggregateId   String       @db.VarChar(120)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @db.Timestamptz(6)
  lockedAt      DateTime?    @db.Timestamptz(6)
  lockedBy      String?      @db.VarChar(120)
  completedAt   DateTime?    @db.Timestamptz(6)
  lastError     String?      @db.Text
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
}

// --- Phase 2: products, categories, supplier codes, warehouses ---
//
// Phase 2 Task 1 introduced a deliberately minimal `Supplier` table (id/code/name/active)
// so `Product.preferredSupplier`/`ProductSupplier` had somewhere real to point rather than
// free text. Phase 3 Task 1 widens it here — addresses, contact details, currency, payment
// terms — with additive columns and a new `SupplierAddress` table, so the foreign keys
// created in Phase 2 are untouched. Purchase orders, bills, payments, and credits (Phase 3
// Tasks 2-6) each add their own tables separately.

model ProductCategory {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @unique @db.VarChar(160)
  parentId  String?           @db.Uuid
  createdAt DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @db.Timestamptz(6)
  parent    ProductCategory?  @relation("ProductCategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children  ProductCategory[] @relation("ProductCategoryParent")
  products  Product[]

  @@index([parentId])
}

enum SupplierAddressType {
  BILLING
  DELIVERY
  GENERAL
}

model Supplier {
  id               String            @id @default(uuid()) @db.Uuid
  code             String            @unique @db.VarChar(40)
  name             String            @db.VarChar(160)
  legalName        String?           @db.VarChar(200)
  taxNumber        String?           @db.VarChar(40)
  currency         String            @default("NZD") @db.Char(3)
  paymentTermsDays Int               @default(20)
  contactName      String?           @db.VarChar(160)
  contactEmail     String?           @db.VarChar(254)
  contactPhone     String?           @db.VarChar(40)
  notes            String?           @db.VarChar(2000)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)
  productLinks     ProductSupplier[]
  preferredFor     Product[]         @relation("ProductPreferredSupplier")
  addresses        SupplierAddress[]
  purchaseOrders   PurchaseOrder[]
  backorders       Backorder[]
  bills            SupplierBill[]
  payments         SupplierPayment[]
  credits          SupplierCredit[]
  refunds          SupplierRefund[]

  @@index([active])
}

model SupplierAddress {
  id           String              @id @default(uuid()) @db.Uuid
  supplierId   String              @db.Uuid
  type         SupplierAddressType
  addressLine1 String?             @db.VarChar(200)
  addressLine2 String?             @db.VarChar(200)
  city         String?             @db.VarChar(120)
  region       String?             @db.VarChar(120)
  postalCode   String?             @db.VarChar(20)
  country      String?             @db.VarChar(120)
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(6)
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, type])
}

model Product {
  id                     String                @id @default(uuid()) @db.Uuid
  sku                    String                @unique @db.VarChar(64)
  barcode                String?               @unique @db.VarChar(64)
  name                   String                @db.VarChar(200)
  description            String?               @db.Text
  categoryId             String?               @db.Uuid
  unitOfMeasure          String                @db.VarChar(20)
  salesPriceMinorUnits   BigInt                @default(0)
  purchaseCostMinorUnits BigInt                @default(0)
  taxRateId              String?               @db.Uuid
  reorderLevel           Decimal               @default(0) @db.Decimal(18, 4)
  reorderQuantity        Decimal               @default(0) @db.Decimal(18, 4)
  leadTimeDays           Int                   @default(0)
  preferredSupplierId    String?               @db.Uuid
  status                 ProductStatus         @default(ACTIVE)
  createdAt              DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @db.Timestamptz(6)
  category               ProductCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  taxRate                TaxRate?              @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  preferredSupplier      Supplier?             @relation("ProductPreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  suppliers              ProductSupplier[]
  stockMovements         StockMovement[]
  stockCountLines        StockCountLine[]
  purchaseOrderLines     PurchaseOrderLine[]
  goodsReceiptLines      GoodsReceiptLine[]
  salesOrderLines        SalesOrderLine[]
  stockReservations      StockReservation[]
  deliveryLines          DeliveryLine[]
  backorderLines         BackorderLine[]
  customerInvoiceLines   CustomerInvoiceLine[]
  supplierBillLines      SupplierBillLine[]

  @@index([categoryId])
  @@index([status])
  @@index([preferredSupplierId])
}

model ProductSupplier {
  id                     String   @id @default(uuid()) @db.Uuid
  productId              String   @db.Uuid
  supplierId             String   @db.Uuid
  supplierProductCode    String   @db.VarChar(80)
  purchaseCostMinorUnits BigInt   @default(0)
  preferred              Boolean  @default(false)
  leadTimeDays           Int      @default(0)
  createdAt              DateTime @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @db.Timestamptz(6)
  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier               Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@index([supplierProductCode])
}

model Warehouse {
  id                String             @id @default(uuid()) @db.Uuid
  code              String             @unique @db.VarChar(20)
  name              String             @unique @db.VarChar(160)
  addressLine1      String?            @db.VarChar(200)
  addressLine2      String?            @db.VarChar(200)
  city              String?            @db.VarChar(120)
  region            String?            @db.VarChar(120)
  postalCode        String?            @db.VarChar(20)
  country           String?            @db.VarChar(120)
  status            WarehouseStatus    @default(ACTIVE)
  isDefault         Boolean            @default(false)
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)
  stockMovements    StockMovement[]
  stockCounts       StockCount[]
  goodsReceipts     GoodsReceipt[]
  salesOrders       SalesOrder[]
  stockReservations StockReservation[]
  deliveries        Delivery[]
  backorders        Backorder[]

  @@index([status])
}

// --- Phase 2 Task 2: immutable stock-movement ledger ---
//
// `StockMovement` is the sole source of truth for stock on hand — no `Product` or
// `Warehouse` row stores an editable balance. Rows are append-only: corrections are made
// with an equal-and-opposite `REVERSAL` row linked via `reversalOfId`, never by editing or
// deleting a posted row. Immutability is enforced twice: the service layer exposes no
// update/delete methods, and a Postgres trigger (added in this task's migration) rejects
// any `UPDATE`/`DELETE` against this table outright, so a bug or a direct SQL session can't
// silently corrupt posted history either.
//
// `(sourceType, sourceId, sourceLineId)` is unique so a given external event (e.g. one
// goods-receipt line) can only ever create a stock effect once, even under retries.
// `idempotencyKey` is a second, independent uniqueness guard for client-side retry safety
// on the posting request itself (a client can resend the same `POST` and get the original
// result back rather than a duplicate or an error).
model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  productId      String            @db.Uuid
  warehouseId    String            @db.Uuid
  movementType   StockMovementType
  signedQuantity Decimal           @db.Decimal(18, 4)
  postedAt       DateTime          @default(now()) @db.Timestamptz(6)
  sourceType     String            @db.VarChar(60)
  sourceId       String            @db.VarChar(120)
  sourceLineId   String            @db.VarChar(120)
  idempotencyKey String?           @unique @db.VarChar(200)
  reversalOfId   String?           @db.Uuid
  actorId        String?           @db.Uuid
  notes          String?           @db.VarChar(2000)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)

  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse  Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  actor      User?           @relation("StockMovementActor", fields: [actorId], references: [id], onDelete: SetNull)
  reversalOf StockMovement?  @relation("StockMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy StockMovement[] @relation("StockMovementReversal")

  @@unique([sourceType, sourceId, sourceLineId])
  @@index([productId, warehouseId])
  @@index([warehouseId])
  @@index([reversalOfId])
  @@index([postedAt])
}

enum StockCountStatus {
  DRAFT
  POSTED
}

// A stock count is a draft worksheet: it freezes `expectedQuantity` per line at creation
// time from the ledger, staff fill in `countedQuantity` as they count, and posting turns
// each line's variance into a `STOCK_COUNT_CORRECTION` movement through the same
// `StockPostingService.postMovements` batch primitive transfers use — so a count either
// posts every non-zero-variance line, or none of them. Once `status` is `POSTED` the count
// is locked: `StockCountsService` exposes no way to edit a line or repost.
model StockCount {
  id          String           @id @default(uuid()) @db.Uuid
  warehouseId String           @db.Uuid
  status      StockCountStatus @default(DRAFT)
  notes       String?          @db.VarChar(2000)
  createdById String           @db.Uuid
  postedAt    DateTime?        @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy User             @relation("StockCountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines     StockCountLine[]

  @@index([warehouseId, status])
}

model StockCountLine {
  id               String   @id @default(uuid()) @db.Uuid
  stockCountId     String   @db.Uuid
  productId        String   @db.Uuid
  expectedQuantity Decimal  @db.Decimal(18, 4)
  countedQuantity  Decimal? @db.Decimal(18, 4)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, productId])
  @@index([productId])
}

// --- Phase 3 Task 2: purchase orders ---
//
// A confirmed purchase order is a commitment, not an amount owed — only posted supplier
// bills (Task 4) create accounts payable. `PurchaseOrderLine` tracks ordered/received/
// returned/billed quantities as plain counters updated transactionally by the services that
// own each effect (Task 3 goods receipts increment `receivedQuantity`; Task 4 bills increment
// `billedQuantity`); `PurchaseOrdersService` derives outstanding/unbilled on read rather than
// storing them, so there is exactly one place each counter is ever written.
enum PurchaseOrderStatus {
  DRAFT
  AWAITING_APPROVAL
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  PARTIALLY_BILLED
  BILLED
  CANCELLED
  CLOSED
}

model PurchaseOrder {
  id           String              @id @default(uuid()) @db.Uuid
  orderNumber  String              @unique @db.VarChar(40)
  supplierId   String              @db.Uuid
  status       PurchaseOrderStatus @default(DRAFT)
  currency     String              @db.Char(3)
  notes        String?             @db.VarChar(2000)
  createdById  String              @db.Uuid
  submittedAt  DateTime?           @db.Timestamptz(6)
  approvedById String?             @db.Uuid
  approvedAt   DateTime?           @db.Timestamptz(6)
  confirmedAt  DateTime?           @db.Timestamptz(6)
  cancelledAt  DateTime?           @db.Timestamptz(6)
  closedAt     DateTime?           @db.Timestamptz(6)
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(6)

  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy     User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy    User?               @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]
  backorders    Backorder[]
  bills         SupplierBill[]

  @@index([supplierId, status])
  @@index([status])
}

model PurchaseOrderLine {
  id                 String   @id @default(uuid()) @db.Uuid
  purchaseOrderId    String   @db.Uuid
  productId          String   @db.Uuid
  unitCostMinorUnits BigInt
  orderedQuantity    Decimal  @db.Decimal(18, 4)
  receivedQuantity   Decimal  @default(0) @db.Decimal(18, 4)
  returnedQuantity   Decimal  @default(0) @db.Decimal(18, 4)
  billedQuantity     Decimal  @default(0) @db.Decimal(18, 4)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  purchaseOrder  PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product        Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptLines   GoodsReceiptLine[]
  backorderLines BackorderLine[]
  billLines      SupplierBillLine[]

  @@index([purchaseOrderId])
  @@index([productId])
}

// --- Phase 3 Task 3: goods receipts ---
//
// A goods receipt posts stock through the Phase 2 `StockPostingService` exactly like every
// other movement source — each `GoodsReceiptLine` posts one `GOODS_RECEIPT` movement with
// `sourceType='goods-receipt-line'` and `sourceLineId=<this line's id>`, so the ledger's own
// duplicate-source-line constraint is what actually prevents a line from ever increasing
// stock twice, not application logic here. Reversal (Task 3 checklist: "equal and opposite
// stock and receipt reversal") goes through `StockPostingService.reverseMovements` for every
// line at once — a receipt is never left half-reversed — and `reversedAt` marks the receipt
// itself so it cannot be reversed a second time.
model GoodsReceipt {
  id              String    @id @default(uuid()) @db.Uuid
  receiptNumber   String    @unique @db.VarChar(40)
  purchaseOrderId String    @db.Uuid
  warehouseId     String    @db.Uuid
  notes           String?   @db.VarChar(2000)
  receivedById    String    @db.Uuid
  reversedAt      DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receivedBy    User               @relation("GoodsReceiptReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  lines         GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([warehouseId])
}

model GoodsReceiptLine {
  id                  String   @id @default(uuid()) @db.Uuid
  goodsReceiptId      String   @db.Uuid
  purchaseOrderLineId String   @db.Uuid
  productId           String   @db.Uuid
  receivedQuantity    Decimal  @db.Decimal(18, 4)
  rejectedQuantity    Decimal  @default(0) @db.Decimal(18, 4)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
}

/// A posted bill, credit, and refund are all immutable financial records: corrections happen
/// through `SupplierCredit`/`SupplierRefund`, or by voiding the bill, never by editing a posted
/// amount — the accounts-payable mirror of `CustomerInvoiceStatus`.
enum SupplierBillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOIDED
  CREDITED
}

/// A bill records supplier-owed amount off received-but-unbilled purchase order lines
/// (`PurchaseOrderLine.receivedQuantity - billedQuantity`, already tracked since Phase 3).
/// `status` only ever holds the five persisted values above; "Overdue" is derived at read time
/// from `status` and `dueDate`, mirroring `CustomerInvoice`.
model SupplierBill {
  id                String             @id @default(uuid()) @db.Uuid
  billNumber        String             @unique @db.VarChar(40)
  supplierId        String             @db.Uuid
  purchaseOrderId   String             @db.Uuid
  status            SupplierBillStatus @default(UNPAID)
  currency          String             @db.Char(3)
  supplierReference String?            @db.VarChar(120)
  issueDate         DateTime           @db.Timestamptz(6)
  dueDate           DateTime           @db.Timestamptz(6)
  notes             String?            @db.VarChar(2000)
  createdById       String             @db.Uuid
  voidedById        String?            @db.Uuid
  voidedAt          DateTime?          @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)

  supplier           Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder      PurchaseOrder               @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  createdBy          User                        @relation("SupplierBillCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy           User?                       @relation("SupplierBillVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  lines              SupplierBillLine[]
  paymentAllocations SupplierPaymentAllocation[]
  creditApplications SupplierCreditApplication[]

  @@index([supplierId, status])
  @@index([status, dueDate])
  @@index([purchaseOrderId])
}

/// `(supplierBillId, purchaseOrderLineId)` is unique so the same received quantity on a
/// purchase order line can never be billed twice, no matter how many separate bills are raised
/// against the order over time.
model SupplierBillLine {
  id                  String   @id @default(uuid()) @db.Uuid
  supplierBillId      String   @db.Uuid
  purchaseOrderLineId String   @db.Uuid
  productId           String   @db.Uuid
  unitCostMinorUnits  BigInt
  quantity            Decimal  @db.Decimal(18, 4)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  supplierBill      SupplierBill      @relation(fields: [supplierBillId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([supplierBillId, purchaseOrderLineId])
  @@index([supplierBillId])
  @@index([purchaseOrderLineId])
}

/// A payment is recorded once, in full, against the supplier account, then allocated across
/// eligible open bills oldest-first — the accounts-payable mirror of `CustomerPayment`.
model SupplierPayment {
  id               String    @id @default(uuid()) @db.Uuid
  paymentNumber    String    @unique @db.VarChar(40)
  supplierId       String    @db.Uuid
  amountMinorUnits BigInt
  currency         String    @db.Char(3)
  method           String    @db.VarChar(60)
  reference        String?   @db.VarChar(120)
  paidAt           DateTime  @db.Timestamptz(6)
  notes            String?   @db.VarChar(2000)
  createdById      String    @db.Uuid
  idempotencyKey   String    @unique @db.VarChar(200)
  reversedAt       DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)

  supplier    Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy   User                        @relation("SupplierPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  allocations SupplierPaymentAllocation[]
  credits     SupplierCredit[]

  @@index([supplierId, paidAt])
}

model SupplierPaymentAllocation {
  id                String    @id @default(uuid()) @db.Uuid
  supplierPaymentId String    @db.Uuid
  supplierBillId    String    @db.Uuid
  amountMinorUnits  BigInt
  createdById       String    @db.Uuid
  reversedAt        DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  supplierPayment SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)
  supplierBill    SupplierBill    @relation(fields: [supplierBillId], references: [id], onDelete: Restrict)
  createdBy       User            @relation("SupplierPaymentAllocationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([supplierPaymentId])
  @@index([supplierBillId])
}

/// Unapplied value on a supplier account — raised automatically when a payment overpays its
/// bills (`sourcePaymentId` set), or manually (e.g. a supplier-issued goodwill credit).
model SupplierCredit {
  id                  String   @id @default(uuid()) @db.Uuid
  creditNumber        String   @unique @db.VarChar(40)
  supplierId          String   @db.Uuid
  sourceType          String   @db.VarChar(30)
  sourcePaymentId     String?  @db.Uuid
  amountMinorUnits    BigInt
  remainingMinorUnits BigInt
  currency            String   @db.Char(3)
  notes               String?  @db.VarChar(2000)
  createdById         String   @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  supplier      Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sourcePayment SupplierPayment?            @relation(fields: [sourcePaymentId], references: [id], onDelete: SetNull)
  createdBy     User                        @relation("SupplierCreditCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  applications  SupplierCreditApplication[]
  refunds       SupplierRefund[]

  @@index([supplierId])
}

model SupplierCreditApplication {
  id               String    @id @default(uuid()) @db.Uuid
  supplierCreditId String    @db.Uuid
  supplierBillId   String    @db.Uuid
  amountMinorUnits BigInt
  createdById      String    @db.Uuid
  reversedAt       DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)

  supplierCredit SupplierCredit @relation(fields: [supplierCreditId], references: [id], onDelete: Cascade)
  supplierBill   SupplierBill   @relation(fields: [supplierBillId], references: [id], onDelete: Restrict)
  createdBy      User           @relation("SupplierCreditApplicationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([supplierCreditId])
  @@index([supplierBillId])
}

/// Money paid back out for unapplied supplier credit — always draws down a `SupplierCredit`,
/// never issued directly against a bill.
model SupplierRefund {
  id               String   @id @default(uuid()) @db.Uuid
  refundNumber     String   @unique @db.VarChar(40)
  supplierId       String   @db.Uuid
  supplierCreditId String   @db.Uuid
  amountMinorUnits BigInt
  currency         String   @db.Char(3)
  method           String   @db.VarChar(60)
  reference        String?  @db.VarChar(120)
  notes            String?  @db.VarChar(2000)
  createdById      String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  supplier       Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierCredit SupplierCredit @relation(fields: [supplierCreditId], references: [id], onDelete: Restrict)
  createdBy      User           @relation("SupplierRefundCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([supplierId])
  @@index([supplierCreditId])
}

// --- Phase 4: customers, sales orders, reservations, deliveries, backorders ---
//
// Phase 4 keeps confirmed sales demand, reservations, deliveries, and backorders as four
// separate record types with four separate statuses, because they answer four different
// questions:
//
//   * a `SalesOrderLine` records what a customer asked for (a commercial commitment),
//   * a `StockReservation` records a soft claim on stock that has *not* moved,
//   * a `Delivery` is the only thing that ever reduces stock, and does so exclusively
//     through the Phase 2 `StockMovement` ledger, and
//   * a `Backorder` records demand that could not be reserved and is waiting on supply.
//
// Nothing here stores a stock balance: available stock is always
// `SUM(StockMovement.signedQuantity) - SUM(active StockReservation.quantity)`, derived on
// read. Delivered quantity is left on the line for Phase 5 invoicing to consume; this phase
// never writes an invoice or a receivable.

enum CustomerAddressType {
  BILLING
  DELIVERY
  GENERAL
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_ALLOCATED
  ALLOCATED
  PARTIALLY_DELIVERED
  DELIVERED
  BACKORDERED
  CANCELLED
  CLOSED
}

/// Invoicing is tracked separately from fulfilment so Phase 5 can advance it without ever
/// rewriting a fulfilment status. Phase 4 only ever leaves this at `NOT_INVOICED`.
enum SalesOrderInvoicingStatus {
  NOT_INVOICED
  PARTIALLY_INVOICED
  INVOICED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum DeliveryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum BackorderStatus {
  PENDING_STOCK
  PARTIALLY_AVAILABLE
  READY_TO_FULFIL
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

model Customer {
  id                    String   @id @default(uuid()) @db.Uuid
  code                  String   @unique @db.VarChar(40)
  name                  String   @db.VarChar(160)
  legalName             String?  @db.VarChar(200)
  taxNumber             String?  @db.VarChar(40)
  currency              String   @default("NZD") @db.Char(3)
  paymentTermsDays      Int      @default(20)
  creditLimitMinorUnits BigInt   @default(0)
  contactName           String?  @db.VarChar(160)
  contactEmail          String?  @db.VarChar(254)
  contactPhone          String?  @db.VarChar(40)
  notes                 String?  @db.VarChar(2000)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)

  addresses   CustomerAddress[]
  salesOrders SalesOrder[]
  backorders  Backorder[]
  invoices    CustomerInvoice[]
  payments    CustomerPayment[]
  credits     CustomerCredit[]
  refunds     CustomerRefund[]

  @@index([active])
  @@index([name])
}

model CustomerAddress {
  id           String              @id @default(uuid()) @db.Uuid
  customerId   String              @db.Uuid
  type         CustomerAddressType
  addressLine1 String?             @db.VarChar(200)
  addressLine2 String?             @db.VarChar(200)
  city         String?             @db.VarChar(120)
  region       String?             @db.VarChar(120)
  postalCode   String?             @db.VarChar(20)
  country      String?             @db.VarChar(120)
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(6)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, type])
}

model SalesOrder {
  id                String                    @id @default(uuid()) @db.Uuid
  orderNumber       String                    @unique @db.VarChar(40)
  customerId        String                    @db.Uuid
  warehouseId       String                    @db.Uuid
  status            SalesOrderStatus          @default(DRAFT)
  invoicingStatus   SalesOrderInvoicingStatus @default(NOT_INVOICED)
  currency          String                    @db.Char(3)
  priority          Int                       @default(5)
  promisedDate      DateTime?                 @db.Timestamptz(6)
  customerReference String?                   @db.VarChar(120)
  notes             String?                   @db.VarChar(2000)
  createdById       String                    @db.Uuid
  confirmedById     String?                   @db.Uuid
  confirmedAt       DateTime?                 @db.Timestamptz(6)
  cancelledAt       DateTime?                 @db.Timestamptz(6)
  closedAt          DateTime?                 @db.Timestamptz(6)
  createdAt         DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @db.Timestamptz(6)

  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy    User               @relation("SalesOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy  User?              @relation("SalesOrderConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  lines        SalesOrderLine[]
  reservations StockReservation[]
  deliveries   Delivery[]
  backorders   Backorder[]
  invoices     CustomerInvoice[]

  @@index([customerId, status])
  @@index([status])
  @@index([warehouseId, status])
  @@index([priority, promisedDate])
  @@index([confirmedAt])
}

/// Every quantity on a sales-order line is a plain counter written by exactly one owner:
/// `reservedQuantity` by `ReservationsService`, `deliveredQuantity` by `DeliveriesService`,
/// `backorderedQuantity` by `BackordersService`, `cancelledQuantity` by `SalesOrdersService`,
/// and `invoicedQuantity` by Phase 5. Outstanding is always derived on read, never stored.
/// The `SalesOrderLine_quantity_balance` check constraint (see this phase's migration) is the
/// database-level guarantee that delivered + cancelled + reserved + backordered can never
/// exceed ordered, no matter which service writes last.
model SalesOrderLine {
  id                   String   @id @default(uuid()) @db.Uuid
  salesOrderId         String   @db.Uuid
  productId            String   @db.Uuid
  unitPriceMinorUnits  BigInt
  discountPercentBasis Int      @default(0)
  orderedQuantity      Decimal  @db.Decimal(18, 4)
  reservedQuantity     Decimal  @default(0) @db.Decimal(18, 4)
  deliveredQuantity    Decimal  @default(0) @db.Decimal(18, 4)
  cancelledQuantity    Decimal  @default(0) @db.Decimal(18, 4)
  backorderedQuantity  Decimal  @default(0) @db.Decimal(18, 4)
  invoicedQuantity     Decimal  @default(0) @db.Decimal(18, 4)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)

  salesOrder     SalesOrder            @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  reservations   StockReservation[]
  deliveryLines  DeliveryLine[]
  backorderLines BackorderLine[]
  invoiceLines   CustomerInvoiceLine[]

  @@index([salesOrderId])
  @@index([productId])
}

/// A reservation is a soft claim, never a stock movement — reserving stock changes no
/// balance in the ledger, it only reduces what *other* demand may claim. Available stock is
/// therefore `stock on hand - SUM(quantity) WHERE status = 'ACTIVE'`, and the invariant that
/// active reservations never exceed stock on hand is enforced by `ReservationsService` under
/// the same `pg_advisory_xact_lock((productId, warehouseId))` key `StockPostingService` uses,
/// so a reservation and a posting can never race each other into oversubscribed stock.
model StockReservation {
  id               String            @id @default(uuid()) @db.Uuid
  salesOrderId     String            @db.Uuid
  salesOrderLineId String            @db.Uuid
  productId        String            @db.Uuid
  warehouseId      String            @db.Uuid
  quantity         Decimal           @db.Decimal(18, 4)
  status           ReservationStatus @default(ACTIVE)
  method           String            @db.VarChar(40)
  backorderLineId  String?           @db.Uuid
  createdById      String            @db.Uuid
  releasedAt       DateTime?         @db.Timestamptz(6)
  consumedAt       DateTime?         @db.Timestamptz(6)
  notes            String?           @db.VarChar(2000)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)

  salesOrder     SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  salesOrderLine SalesOrderLine @relation(fields: [salesOrderLineId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy      User           @relation("StockReservationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  backorderLine  BackorderLine? @relation(fields: [backorderLineId], references: [id], onDelete: SetNull)

  @@index([productId, warehouseId, status])
  @@index([salesOrderId, status])
  @@index([salesOrderLineId, status])
  @@index([backorderLineId])
}

/// A delivery is the only Phase 4 record that touches stock, and it does so exclusively
/// through `StockPostingService`: each `DeliveryLine` posts one `SALES_DELIVERY` movement with
/// `sourceType='delivery-line'` and `sourceLineId=<that line's id>`, so the ledger's own
/// `(sourceType, sourceId, sourceLineId)` unique constraint — not application logic — is what
/// makes it impossible for a delivery line to consume stock twice. A delivery is created as a
/// `DRAFT` and posts separately, so quantities can be reviewed before any stock moves.
model Delivery {
  id             String         @id @default(uuid()) @db.Uuid
  deliveryNumber String         @unique @db.VarChar(40)
  salesOrderId   String         @db.Uuid
  warehouseId    String         @db.Uuid
  status         DeliveryStatus @default(DRAFT)
  notes          String?        @db.VarChar(2000)
  createdById    String         @db.Uuid
  postedById     String?        @db.Uuid
  postedAt       DateTime?      @db.Timestamptz(6)
  reversedAt     DateTime?      @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  warehouse  Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy  User           @relation("DeliveryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy   User?          @relation("DeliveryPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  lines      DeliveryLine[]

  @@index([salesOrderId, status])
  @@index([warehouseId, status])
  @@index([status])
}

model DeliveryLine {
  id               String   @id @default(uuid()) @db.Uuid
  deliveryId       String   @db.Uuid
  salesOrderLineId String   @db.Uuid
  productId        String   @db.Uuid
  quantity         Decimal  @db.Decimal(18, 4)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  delivery       Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  salesOrderLine SalesOrderLine @relation(fields: [salesOrderLineId], references: [id], onDelete: Restrict)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([deliveryId, salesOrderLineId])
  @@index([deliveryId])
  @@index([salesOrderLineId])
}

/// A backorder records confirmed demand that could not be reserved. It stays linked to the
/// sales order and line it came from, and optionally to the supplier and purchase order raised
/// to cover it, so every backordered quantity traces to both the customer promise and the
/// supply that will satisfy it.
model Backorder {
  id              String          @id @default(uuid()) @db.Uuid
  backorderNumber String          @unique @db.VarChar(40)
  salesOrderId    String          @db.Uuid
  customerId      String          @db.Uuid
  warehouseId     String          @db.Uuid
  status          BackorderStatus @default(PENDING_STOCK)
  priority        Int             @default(5)
  expectedDate    DateTime?       @db.Timestamptz(6)
  promisedDate    DateTime?       @db.Timestamptz(6)
  supplierId      String?         @db.Uuid
  purchaseOrderId String?         @db.Uuid
  notes           String?         @db.VarChar(2000)
  createdById     String          @db.Uuid
  cancelledAt     DateTime?       @db.Timestamptz(6)
  fulfilledAt     DateTime?       @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)

  salesOrder    SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  supplier      Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdBy     User            @relation("BackorderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines         BackorderLine[]

  @@index([salesOrderId])
  @@index([customerId, status])
  @@index([status, priority])
  @@index([warehouseId, status])
  @@index([expectedDate])
  @@index([purchaseOrderId])
}

model BackorderLine {
  id                  String   @id @default(uuid()) @db.Uuid
  backorderId         String   @db.Uuid
  salesOrderLineId    String   @db.Uuid
  productId           String   @db.Uuid
  quantity            Decimal  @db.Decimal(18, 4)
  allocatedQuantity   Decimal  @default(0) @db.Decimal(18, 4)
  fulfilledQuantity   Decimal  @default(0) @db.Decimal(18, 4)
  cancelledQuantity   Decimal  @default(0) @db.Decimal(18, 4)
  purchaseOrderLineId String?  @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)

  backorder         Backorder             @relation(fields: [backorderId], references: [id], onDelete: Cascade)
  salesOrderLine    SalesOrderLine        @relation(fields: [salesOrderLineId], references: [id], onDelete: Restrict)
  product           Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseOrderLine PurchaseOrderLine?    @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  allocations       BackorderAllocation[]
  reservations      StockReservation[]

  @@unique([backorderId, salesOrderLineId])
  @@index([backorderId])
  @@index([salesOrderLineId])
  @@index([productId])
  @@index([purchaseOrderLineId])
}

/// One incoming-stock allocation to one backorder line. `(backorderLineId, sourceLineId)` is
/// unique, so the same incoming quantity — identified by the goods-receipt line that brought
/// it in — can never be allocated to the same backorder line twice, even under retries.
model BackorderAllocation {
  id              String   @id @default(uuid()) @db.Uuid
  backorderLineId String   @db.Uuid
  sourceType      String   @db.VarChar(60)
  sourceId        String   @db.VarChar(120)
  sourceLineId    String   @db.VarChar(120)
  quantity        Decimal  @db.Decimal(18, 4)
  reservationId   String?  @db.Uuid
  createdById     String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  backorderLine BackorderLine @relation(fields: [backorderLineId], references: [id], onDelete: Cascade)
  createdBy     User          @relation("BackorderAllocationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([backorderLineId, sourceLineId])
  @@index([sourceType, sourceId])
}

/// A posted invoice, credit, and refund are all immutable financial records (per the
/// project's non-negotiable rules): corrections happen through `CustomerCredit` and
/// `CustomerRefund`, or by voiding the invoice, never by editing a posted amount.
enum CustomerInvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOIDED
  CREDITED
}

enum InstallmentFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  CUSTOM
}

/// An invoice bills delivered-but-not-yet-invoiced quantity off one sales order's lines
/// (`SalesOrderLine.deliveredQuantity - invoicedQuantity`, Phase 4's `uninvoicedQuantity`
/// projection). `status` only ever holds the five persisted values above; "Overdue" from the
/// roadmap's status list is derived at read time from `status` and `dueDate` — see
/// `deriveCustomerInvoiceDisplayStatus` in `packages/domain` — so nothing has to sweep the
/// table on a schedule to flip a stored flag.
model CustomerInvoice {
  id            String                @id @default(uuid()) @db.Uuid
  invoiceNumber String                @unique @db.VarChar(40)
  customerId    String                @db.Uuid
  salesOrderId  String                @db.Uuid
  status        CustomerInvoiceStatus @default(UNPAID)
  currency      String                @db.Char(3)
  issueDate     DateTime              @db.Timestamptz(6)
  dueDate       DateTime              @db.Timestamptz(6)
  notes         String?               @db.VarChar(2000)
  createdById   String                @db.Uuid
  voidedById    String?               @db.Uuid
  voidedAt      DateTime?             @db.Timestamptz(6)
  createdAt     DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(6)

  customer           Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder         SalesOrder                  @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  createdBy          User                        @relation("CustomerInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy           User?                       @relation("CustomerInvoiceVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  lines              CustomerInvoiceLine[]
  paymentAllocations CustomerPaymentAllocation[]
  creditApplications CustomerCreditApplication[]
  installmentPlan    InstallmentPlan?

  @@index([customerId, status])
  @@index([status, dueDate])
  @@index([salesOrderId])
}

/// `(customerInvoiceId, salesOrderLineId)` is unique so the same delivered quantity on a
/// sales order line can never be invoiced twice, no matter how many separate invoices are
/// raised against the order over time.
model CustomerInvoiceLine {
  id                   String   @id @default(uuid()) @db.Uuid
  customerInvoiceId    String   @db.Uuid
  salesOrderLineId     String   @db.Uuid
  productId            String   @db.Uuid
  unitPriceMinorUnits  BigInt
  discountPercentBasis Int      @default(0)
  quantity             Decimal  @db.Decimal(18, 4)
  /// Snapshotted from the product's tax rate at invoice-creation time, not looked up live, so a
  /// later change to the tax rate's percentage never retroactively changes an already-posted
  /// invoice's total.
  taxRateId            String?  @db.Uuid
  taxAmountMinorUnits  BigInt   @default(0)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)

  customerInvoice CustomerInvoice @relation(fields: [customerInvoiceId], references: [id], onDelete: Cascade)
  salesOrderLine  SalesOrderLine  @relation(fields: [salesOrderLineId], references: [id], onDelete: Restrict)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  taxRate         TaxRate?        @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  @@unique([customerInvoiceId, salesOrderLineId])
  @@index([customerInvoiceId])
  @@index([salesOrderLineId])
  @@index([taxRateId])
}

/// A payment is recorded once, in full, against the customer account — never pre-split across
/// invoices by the caller. `CustomerPaymentsService` does the splitting via
/// `CustomerPaymentAllocation` rows, oldest-invoice-first, exactly like the roadmap's
/// "Customer Payment Posting" workflow. `idempotencyKey` is the duplicate-payment guard: the
/// same payment request retried returns the original payment rather than posting twice.
model CustomerPayment {
  id               String    @id @default(uuid()) @db.Uuid
  paymentNumber    String    @unique @db.VarChar(40)
  customerId       String    @db.Uuid
  amountMinorUnits BigInt
  currency         String    @db.Char(3)
  method           String    @db.VarChar(60)
  reference        String?   @db.VarChar(120)
  receivedAt       DateTime  @db.Timestamptz(6)
  notes            String?   @db.VarChar(2000)
  createdById      String    @db.Uuid
  idempotencyKey   String    @unique @db.VarChar(200)
  reversedAt       DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)

  customer    Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy   User                        @relation("CustomerPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  allocations CustomerPaymentAllocation[]
  credits     CustomerCredit[]

  @@index([customerId, receivedAt])
}

/// One payment's claim against one invoice. A reversal never deletes the row — it stamps
/// `reversedAt` and the reversing write also reduces the invoice's paid total in the same
/// transaction, so the full history of every allocation and reversal is preserved.
model CustomerPaymentAllocation {
  id                String    @id @default(uuid()) @db.Uuid
  customerPaymentId String    @db.Uuid
  customerInvoiceId String    @db.Uuid
  amountMinorUnits  BigInt
  createdById       String    @db.Uuid
  reversedAt        DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  customerPayment CustomerPayment @relation(fields: [customerPaymentId], references: [id], onDelete: Cascade)
  customerInvoice CustomerInvoice @relation(fields: [customerInvoiceId], references: [id], onDelete: Restrict)
  createdBy       User            @relation("CustomerPaymentAllocationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerPaymentId])
  @@index([customerInvoiceId])
}

/// Unapplied value on a customer's account — raised automatically when a payment overpays its
/// invoices (`sourcePaymentId` set), or manually (e.g. a goodwill credit). `remainingMinorUnits`
/// is the live balance; `amountMinorUnits` is the original grant and never changes once posted.
model CustomerCredit {
  id                  String   @id @default(uuid()) @db.Uuid
  creditNumber        String   @unique @db.VarChar(40)
  customerId          String   @db.Uuid
  sourceType          String   @db.VarChar(30)
  sourcePaymentId     String?  @db.Uuid
  amountMinorUnits    BigInt
  remainingMinorUnits BigInt
  currency            String   @db.Char(3)
  notes               String?  @db.VarChar(2000)
  createdById         String   @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  customer      Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourcePayment CustomerPayment?            @relation(fields: [sourcePaymentId], references: [id], onDelete: SetNull)
  createdBy     User                        @relation("CustomerCreditCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  applications  CustomerCreditApplication[]
  refunds       CustomerRefund[]

  @@index([customerId])
}

/// One credit's application against one invoice — mirrors `CustomerPaymentAllocation`, with
/// the same reversal-by-stamp discipline.
model CustomerCreditApplication {
  id                String    @id @default(uuid()) @db.Uuid
  customerCreditId  String    @db.Uuid
  customerInvoiceId String    @db.Uuid
  amountMinorUnits  BigInt
  createdById       String    @db.Uuid
  reversedAt        DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  customerCredit  CustomerCredit  @relation(fields: [customerCreditId], references: [id], onDelete: Cascade)
  customerInvoice CustomerInvoice @relation(fields: [customerInvoiceId], references: [id], onDelete: Restrict)
  createdBy       User            @relation("CustomerCreditApplicationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerCreditId])
  @@index([customerInvoiceId])
}

/// Paying real money back out for unapplied credit. Always draws down a `CustomerCredit`
/// (`customerCreditId`), never issued directly against an invoice — a refund is the credit
/// leaving the account, not a second way to touch invoice balances.
model CustomerRefund {
  id               String   @id @default(uuid()) @db.Uuid
  refundNumber     String   @unique @db.VarChar(40)
  customerId       String   @db.Uuid
  customerCreditId String   @db.Uuid
  amountMinorUnits BigInt
  currency         String   @db.Char(3)
  method           String   @db.VarChar(60)
  reference        String?  @db.VarChar(120)
  notes            String?  @db.VarChar(2000)
  createdById      String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerCredit CustomerCredit @relation(fields: [customerCreditId], references: [id], onDelete: Restrict)
  createdBy      User           @relation("CustomerRefundCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([customerCreditId])
}

/// A deposit/final or recurring schedule for one invoice. Unscheduled partial payments remain
/// allowed regardless — `InstallmentScheduleLine.paidAmountMinorUnits` is informational,
/// tracking progress against the plan; it is not itself a payable record and does not gate
/// `CustomerPaymentsService` from allocating a payment to this invoice at any time.
model InstallmentPlan {
  id                String               @id @default(uuid()) @db.Uuid
  customerInvoiceId String               @unique @db.Uuid
  frequency         InstallmentFrequency
  createdById       String               @db.Uuid
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)

  customerInvoice CustomerInvoice           @relation(fields: [customerInvoiceId], references: [id], onDelete: Cascade)
  createdBy       User                      @relation("InstallmentPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines           InstallmentScheduleLine[]
}

model InstallmentScheduleLine {
  id                   String   @id @default(uuid()) @db.Uuid
  installmentPlanId    String   @db.Uuid
  dueDate              DateTime @db.Timestamptz(6)
  amountMinorUnits     BigInt
  paidAmountMinorUnits BigInt   @default(0)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)

  installmentPlan InstallmentPlan @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)

  @@index([installmentPlanId])
}
