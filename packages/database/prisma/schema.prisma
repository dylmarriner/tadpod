generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique @db.VarChar(254)
  displayName  String         @db.VarChar(120)
  passwordHash String         @db.Text
  status       UserStatus     @default(ACTIVE)
  version      Int            @default(1)
  lastLoginAt  DateTime?      @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(6)
  roles        UserRole[]
  sessions     RefreshSession[]
  auditLogs    AuditLog[]
  attachments  Attachment[]   @relation("AttachmentUploader")

  @@index([status, email])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(80)
  name        String           @unique @db.VarChar(120)
  description String?          @db.VarChar(300)
  system      Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(120)
  name        String           @db.VarChar(160)
  description String?          @db.VarChar(300)
  roles       RolePermission[]
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId      String     @db.Uuid
  permissionId String    @db.Uuid
  role        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission  Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshSession {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  tokenHash    String        @unique @db.Char(64)
  status       SessionStatus @default(ACTIVE)
  userAgent    String?       @db.VarChar(500)
  ipAddress    String?       @db.Inet
  expiresAt    DateTime      @db.Timestamptz(6)
  revokedAt    DateTime?     @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  lastUsedAt   DateTime?     @db.Timestamptz(6)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @db.VarChar(120)
  entityId   String?  @db.VarChar(120)
  requestId  String?  @db.VarChar(120)
  ipAddress  String?  @db.Inet
  metadata   Json
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  scope          String   @db.VarChar(120)
  key            String   @db.VarChar(200)
  requestHash    String   @db.Char(64)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime @db.Timestamptz(6)

  @@unique([scope, key])
  @@index([expiresAt])
}

model DocumentSequence {
  key       String   @id @db.VarChar(80)
  prefix    String   @db.VarChar(20)
  nextValue BigInt   @default(1)
  padding   Int      @default(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model BrandSettings {
  singletonKey   String   @id @default("default") @db.VarChar(20)
  displayName    String   @default("TADPODS") @db.VarChar(80)
  legalName      String?  @db.VarChar(160)
  logoUrl        String?  @db.Text
  primaryColour  String   @default("#0F766E") @db.Char(7)
  accentColour   String   @default("#14B8A6") @db.Char(7)
  documentFooter String   @default("Generated by TADPODS") @db.VarChar(500)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  updatedById    String?  @db.Uuid
}

model SystemSettings {
  singletonKey         String   @id @default("default") @db.VarChar(20)
  defaultCurrency      String   @default("NZD") @db.Char(3)
  negativeStockEnabled Boolean  @default(false)
  timeZone              String   @default("Pacific/Auckland") @db.VarChar(80)
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)
}

model TaxRate {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(120)
  rateBasis Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  objectKey    String   @unique @db.Text
  fileName     String   @db.VarChar(255)
  contentType  String   @db.VarChar(160)
  sizeBytes    BigInt
  sha256       String   @db.Char(64)
  entityType   String   @db.VarChar(120)
  entityId     String   @db.VarChar(120)
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  uploadedBy   User     @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  topic         String       @db.VarChar(120)
  aggregateType String       @db.VarChar(120)
  aggregateId   String       @db.VarChar(120)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @db.Timestamptz(6)
  lockedAt      DateTime?    @db.Timestamptz(6)
  lockedBy      String?      @db.VarChar(120)
  completedAt   DateTime?    @db.Timestamptz(6)
  lastError     String?      @db.Text
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
}
